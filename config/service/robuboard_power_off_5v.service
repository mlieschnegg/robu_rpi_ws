[Unit]
Description=Power off 5V supply (GPIO26) on poweroff/halt only
DefaultDependencies=no
# Erst nach dem Stoppen der normalen Dienste abschalten.
After=shutdown.target
Before=poweroff.target halt.target systemd-poweroff.service systemd-halt.service
# Before= regelt nur die Reihenfolge. Der Python-Code prüft zusätzlich den
# tatsächlichen Shutdown-Auftrag und lässt GPIO26 bei Reboot unverändert.

[Service]
Type=oneshot
ExecCondition=/home/robu/work/.robu/config/service/is_robuboard.sh
ExecStart=/usr/bin/python3 /home/robu/work/.robu/src/robuboard/robuboard/rpi/robuboard_power_off_5v.py
TimeoutStartSec=5

[Install]
WantedBy=poweroff.target halt.target
