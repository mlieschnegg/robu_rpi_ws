    "KeyReader class (non-blocking stdin)": {
        "prefix": "keyreader",
        "description": "Non-blocking keyboard reader using termios/tty/select",
        "body": [
            "from __future__ import annotations",
            "",
            "import fcntl",
            "import os",
            "import select",
            "import sys",
            "import termios",
            "import tty",
            "from types import TracebackType",
            "",
            "",
            "class KeyReader:",
            "    def __init__(self) -> None:",
            "        self._file_descriptor: int = sys.stdin.fileno()",
            "        self._old_settings = termios.tcgetattr(self._file_descriptor)",
            "        self._old_flags: int = fcntl.fcntl(self._file_descriptor, fcntl.F_GETFL)",
            "",
            "    def __enter__(self) -> KeyReader:",
            "        tty.setraw(self._file_descriptor)",
            "        settings = termios.tcgetattr(self._file_descriptor)",
            "        settings[1] |= termios.OPOST | termios.ONLCR",
            "        termios.tcsetattr(self._file_descriptor, termios.TCSADRAIN, settings)",
            "        fcntl.fcntl(self._file_descriptor, fcntl.F_SETFL, self._old_flags | os.O_NONBLOCK)",
            "        return self",
            "",
            "    def __exit__(",
            "        self,",
            "        exc_type: type[BaseException] | None,",
            "        exc: BaseException | None,",
            "        traceback: TracebackType | None,",
            "    ) -> None:",
            "        termios.tcsetattr(self._file_descriptor, termios.TCSADRAIN, self._old_settings)",
            "        fcntl.fcntl(self._file_descriptor, fcntl.F_SETFL, self._old_flags)",
            "",
            "    def read_available(self) -> str:",
            "        chunks: list[str] = []",
            "        while True:",
            "            ready, _, _ = select.select([sys.stdin], [], [], 0)",
            "            if not ready:",
            "                break",
            "            try:",
            "                data = os.read(self._file_descriptor, 1024)",
            "                if not data:",
            "                    break",
            "                chunks.append(data.decode('utf-8', errors='ignore'))",
            "            except BlockingIOError:",
            "                break",
            "        return ''.join(chunks)"
        ]
    },
