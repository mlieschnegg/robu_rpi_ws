    "ROS2 StateMachine Base": {
        "prefix": "ros_sm_base",
        "description": "Basisklassen State und StateMachine für ROS2-Zustandsautomat",
        "body": [
            "from __future__ import annotations",
            "",
            "from abc import ABC, abstractmethod",
            "",
            "from rclpy.node import Node",
            "",
            "",
            "class State(ABC):",
            "    def __init__(self, name: str) -> None:",
            "        self.name: str = name",
            "",
            "    def on_enter(self, node: Node) -> None:",
            "        pass",
            "",
            "    def on_exit(self, node: Node) -> None:",
            "        pass",
            "",
            "    @abstractmethod",
            "    def tick(self, node: Node) -> str | None:",
            "        \"\"\"Return the next state name, or None to stay in this state.\"\"\"",
            "        ...",
            "",
            "",
            "class StateMachine:",
            "    def __init__(self, node: Node) -> None:",
            "        self._node: Node = node",
            "        self._states: dict[str, State] = {}",
            "        self._current_state: State | None = None",
            "",
            "    def add_state(self, state: State) -> None:",
            "        self._states[state.name] = state",
            "",
            "    def set_initial_state(self, name: str) -> None:",
            "        self._current_state = self._states[name]",
            "        self._node.get_logger().info(f'Initial state: {name}')",
            "        self._current_state.on_enter(self._node)",
            "",
            "    def step(self) -> None:",
            "        if self._current_state is None:",
            "            return",
            "        next_name = self._current_state.tick(self._node)",
            "        if next_name is not None and next_name != self._current_state.name:",
            "            self._current_state.on_exit(self._node)",
            "            old_name = self._current_state.name",
            "            self._current_state = self._states[next_name]",
            "            self._node.get_logger().info(f'State change: {old_name} -> {next_name}')",
            "            self._current_state.on_enter(self._node)"
        ]
    },
